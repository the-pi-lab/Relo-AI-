# ==============================================================================
# RELO AI — Environment Configuration Template
# ==============================================================================
#
# This file documents both halves of the deployment. Copy the values you need
# into the right place — they are never read from this file at runtime.
#
#   Frontend (Next.js on Vercel)  -> Project Settings > Environment Variables
#   Backend  (Cloudflare Worker)  -> wrangler secret put <NAME> / wrangler.toml
#
# ==============================================================================

# --- Frontend (Next.js) — safe to expose, they end up in the browser --------
#
# Worker origin, no trailing slash. In local development use
# http://localhost:8787 after `cd backend && npm run dev`.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public origin of this app (no trailing slash). Used for canonicals, Open
# Graph URLs and the link-in-bio preview. Defaults to the request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta OAuth. The redirect URI must be byte-for-byte the same string that is
# registered under Facebook Login > Settings > Valid OAuth Redirect URIs.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_REDIRECT_URI=https://app.relo.ai/auth/meta/callback

# Optional: site key for the Cloudflare Turnstile widget on the login form.
# Leave empty when the Worker has no TURNSTILE_SECRET_KEY (captcha is skipped).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ==============================================================================
# Everything below is BACKEND-ONLY. Configure these as Cloudflare Worker
# secrets (wrangler secret put <NAME>) — never expose them to the frontend,
# and never prefix them with NEXT_PUBLIC_.
# See backend/.env.example for the full annotated list.
# ==============================================================================
