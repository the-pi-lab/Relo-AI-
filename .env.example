# Convex Configuration
# Get your VITE_CONVEX_URL from: https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Auth Configuration (for email OTP)
# Set to your Vercel deployment URL in production
CONVEX_SITE_URL=http://localhost:5173
# Email Provider - Resend
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email sender (must be verified in Resend)
# Default: onboarding@resend.dev (for testing)
# For production, use your own verified domain
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Chat Flow AI v2 (thin control plane) ---
# Public site URL (used for OAuth redirect + postMessage origin allowlist)
SITE_URL=http://localhost:5173
# Meta App (server-side only — never prefix with VITE_)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Optional second secret (Meta signs with either key depending on login type)
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_SECRET=
# Webhook verification token (required, no fallback — must match Meta dashboard)
WEBHOOK_VERIFY_TOKEN=replace-with-a-strong-random-token
# Signs OAuth state tokens (falls back to META_APP_SECRET if unset)
# OAUTH_STATE_SECRET=replace-with-a-strong-random-secret
# Seals customer BACKEND_AUTH_TOKENs for server-side config pushes (required
# once users connect backends; 64 hex chars like ENCRYPTION_KEY)
# BACKEND_TOKEN_KEY=replace-with-a-strong-random-secret

# One-time payment link for the $10 lifetime license (Vite/bundled client-side).
# When unset, Pricing directs users to redeem a key in Settings.
# VITE_BUY_URL=https://your-payment-link