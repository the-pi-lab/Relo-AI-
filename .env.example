# ==============================================================================
# ChatFlow AI — Environment Configuration Template
# ==============================================================================

# --- Frontend Client Configuration ---
# API base URL for Cloudflare Worker engine (falls back to window.location.origin in production)
VITE_API_BASE_URL=http://localhost:8787

# One-time payment link for the $10 lifetime license
VITE_BUY_URL=https://chatflow.ai/checkout/lifetime

# --- Meta Graph API v21.0 Platform Credentials ---
# Meta App ID & App Secrets (from developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Optional secondary secret if signing across both Facebook & Instagram Graph endpoints
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_SECRET=

# Webhook verification token (must match your Meta App Dashboard Webhook settings)
WEBHOOK_VERIFY_TOKEN=replace_with_a_strong_random_token

# --- Cryptographic Keys & Tokens ---
# 64 hex characters (32 bytes) for AES-256-GCM token encryption at rest
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_hex_character_aes_key

# JWT signing secret for passwordless OTP tokens
JWT_SECRET=replace_with_a_high_entropy_jwt_secret

# --- Email OTP Dispatch (Resend API) ---
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=auth@yourdomain.com