# ==============================================================================
# RELO AI — Cloudflare Worker Engine Secrets
# Configure via:  wrangler secret put <NAME>
# Non-secret vars live in backend/wrangler.toml [vars]
#
# Local development: copy this file to backend/.dev.vars (git-ignored) and set
# ENVIRONMENT=development plus DEBUG_OTPS=1. `wrangler dev` reads .dev.vars.
# ==============================================================================

# --- Meta Platform (developers.facebook.com) ---
# App ID + App Secret: required for the server-side OAuth token exchange and
# for the scheduled long-lived token refresh.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Webhook verification token — must match your Meta App Dashboard webhook config
META_VERIFY_TOKEN=replace_with_a_strong_random_token

# --- Cryptographic Keys ---
# AES-256-GCM master key for the Instagram token vault.
# REQUIRED — the engine refuses to operate without it (no fallback).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=replace_with_64_hex_character_aes_key

# JWT signing secret for passwordless OTP sessions
JWT_SECRET=replace_with_a_high_entropy_jwt_secret

# --- Origins (CORS + links) ---
# Worker origin, used to build /l/:id short links. No trailing slash.
PUBLIC_BASE_URL=https://api.relo.ai
# Frontend origin, used for the free-tier branding redirect and CORS.
PUBLIC_APP_URL=https://app.relo.ai
# Comma-separated CORS allowlist. Never a wildcard. localhost is always
# allowed outside production, so you do not need it here.
ALLOWED_ORIGINS=https://app.relo.ai,https://relo.ai

# --- Email OTP Dispatch (Resend) ---
RESEND_API_KEY=re_your_resend_api_key_here

# --- Cloudflare Turnstile (login / signup / contact) ---
# Must match NEXT_PUBLIC_TURNSTILE_SITE_KEY on the frontend.
# Missing secret = captcha verification skipped (a warning is logged).
TURNSTILE_SECRET_KEY=
# Set to 1 to make a missing Turnstile secret a hard startup failure.
REQUIRE_CAPTCHA=

# --- Billing ---
# India: UPI id shown at upgrade. Amounts (₹199 Pro / ₹499 Studio) are decided
# server-side in api/router.ts — changing the price here does nothing.
MANUAL_UPI_ID=relo@upi
# Global: Lemon Squeezy checkout link + webhook signing secret
LEMON_SQUEEZY_CHECKOUT_URL=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- AI product Q&A (optional) ---
# NVIDIA NIM key. Without it every DM takes the owner hand-off path; nothing
# fails and no credit is spent.
NIM_API_KEY=

# --- Owner tooling ---
ADMIN_SECRET=replace_with_a_long_random_string
# Comma-separated bootstrap admin emails (before is_admin is set in D1)
ADMIN_EMAILS=

# --- Optional / dev only ---
# Echo OTP codes in API responses for local development. NEVER set in production.
# DEBUG_OTPS=1
