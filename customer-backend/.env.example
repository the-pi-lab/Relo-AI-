# --- Database (customer-owned Postgres) ---
# NOTE: "relo:relo" is a local development credential placeholder only. Never use default passwords in staging or production.
DATABASE_URL=postgresql://relo:relo@localhost:5432/relo

# --- Server ---
PORT=3000

# --- Meta (Instagram) ---
# At least one app secret is required (Meta signs with either key).
META_APP_SECRET=your_meta_app_secret
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_SECRET=
# Graph host + version (override only if Meta support tells you to)
META_GRAPH_HOST=graph.instagram.com
META_GRAPH_API_VERSION=v25.0

# Must match the Verify Token in your Meta app dashboard (no default).
WEBHOOK_VERIFY_TOKEN=replace-with-a-strong-random-token

# --- Backend auth ---
# High-entropy token RELO uses to push automation config.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_AUTH_TOKEN=replace-with-a-strong-random-token

# --- Connected Instagram account (single-account bootstrap via env) ---
# Multi-account comes via POST /api/config/push (Phase 5 handoff).
IG_ACCOUNT_ID=your_instagram_business_account_id
IG_USERNAME=your_username
META_ACCESS_TOKEN=your_instagram_access_token

# --- Token encryption at rest (recommended) ---
# 64-char hex (32 bytes). Generate like BACKEND_AUTH_TOKEN above.
# Without it, tokens are stored plaintext with a boot warning.
# ENCRYPTION_KEY=

# --- AI (optional, BYO key — never leaves this backend) ---
# none | openai | gemini. Keyword-only flows never call AI regardless.
AI_PROVIDER=none
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL= (optional: OpenAI-compatible proxy endpoint)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL= (optional: compatible proxy endpoint)

# --- Worker tuning (defaults are free-tier friendly) ---
# POLL_INTERVAL_MS=2000
# RATE_LIMIT_MAX=750
